{
  "name": "gerador-cpf",
  "version": "1.0.0",
  "description": "Gerador de CPFs válidos para testes de software, com histórico e sem repetição.",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "test:coverage": "node --test --test-reporter=spec --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 \"tests/**/*.test.js\"",
    "smoke": "node scripts/smoke-test.js http://localhost:3000"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0"
  }
}
